{
  "name": "testeletron",
  "version": "1.0.0",
  "description": "A professional, local-first offline School Management System built as a modern web application, completely capable of running in standard web browsers without Node.js at runtime, and fully packaged for Windows desktop execution with Electron.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "electron": "electron .",
    "build:css": "tailwindcss -i ./css/input.css -o ./css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./css/input.css -o ./css/tailwind.css --watch",
    "serve": "npx serve .",
    "build": "electron-builder"
  },
  "keywords": [
    "school-management",
    "offline-first",
    "electron",
    "indexeddb"
  ],
  "author": "SchoolFlow Team",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "any-promise": "^1.3.0",
    "anymatch": "^3.1.3",
    "arg": "^5.0.2",
    "binary-extensions": "^2.3.0",
    "braces": "^3.0.3",
    "camelcase-css": "^2.0.1",
    "chokidar": "^3.6.0",
    "commander": "^4.1.1",
    "cssesc": "^3.0.1",
    "debug": "^4.4.3",
    "didyoumean": "^1.2.3",
    "dlv": "^1.1.3",
    "env-paths": "^3.0.0",
    "es-errors": "^1.3.0",
    "fast-glob": "^3.3.3",
    "fastq": "^1.20.3",
    "fill-range": "^7.1.1",
    "function-bind": "^1.1.2",
    "glob-parent": "^6.0.2",
    "graceful-fs": "^4.2.11",
    "hasown": "^2.0.2",
    "is-binary-path": "^2.1.0",
    "is-extglob": "^2.1.1",
    "is-glob": "^4.0.3",
    "is-number": "^7.0.0",
    "jiti": "^1.21.7",
    "lilconfig": "^3.1.3",
    "lines-and-columns": "^1.2.4",
    "merge2": "^1.4.1",
    "micromatch": "^4.0.8",
    "ms": "^2.1.3",
    "mz": "^2.7.0",
    "nanoid": "^3.3.18",
    "normalize-path": "^3.0.0",
    "object-assign": "^4.1.1",
    "object-hash": "^3.0.0",
    "path-parse": "^1.22.12",
    "picocolors": "^1.1.1",
    "picomatch": "^2.3.2",
    "pirates": "^4.0.7",
    "postcss": "^8.5.28",
    "postcss-import": "^15.1.0",
    "postcss-js": "^4.0.1",
    "postcss-load-config": "^4.0.2",
    "postcss-nested": "^6.2.0",
    "postcss-selector-parser": "^6.1.4",
    "postcss-value-parser": "^4.2.0",
    "progress": "^2.0.3",
    "queue-microtask": "^1.2.3",
    "read-cache": "^1.0.2",
    "readdirp": "^3.6.0",
    "resolve": "^1.22.12",
    "reusify": "^1.1.0",
    "run-parallel": "^1.2.0",
    "semver": "^7.8.5",
    "sumchecker": "^3.0.1",
    "supports-preserve-symlinks-flag": "^1.0.0",
    "thenify": "^3.3.0",
    "thenify-all": "^1.0.0",
    "tinyglobby": "^0.2.17",
    "to-regex-range": "^5.0.1",
    "ts-interface-checker": "^0.1.13",
    "undici": "^7.29.1",
    "undici-types": "^7.18.2",
    "util-deprecate": "^1.0.2",
    "yaml": "^2.9.0"
  },
  "build": {
    "appId": "com.schoolflow.management",
    "productName": "School Management System",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}