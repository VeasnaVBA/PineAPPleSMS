{
  "name": "pineapplesms",
  "version": "1.0.0",
  "description": "A professional, local-first offline School Management System built as a modern web application, completely capable of running in standard web browsers without Node.js at runtime, and fully packaged for Windows desktop execution with Electron.",
  "scripts": {
    "start": "electron main.js",
    "electron": "electron main.js",
    "build": "tailwindcss -i ./css/input.css -o ./css/tailwind.css --minify",
    "build:css": "tailwindcss -i ./css/input.css -o ./css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./css/input.css -o ./css/tailwind.css --watch",
    "serve": "npx serve .",
    "build:electron": "electron-builder"
  },
  "keywords": [
    "school-management",
    "offline-first",
    "electron",
    "indexeddb"
  ],
  "author": "SchoolFlow Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^3.4.17"
  },
  "build": {
    "appId": "com.pineapplesms.app",
    "productName": "PineAPPleSMS",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}